# Base URL of the school's API (Laravel project_manager, /api/v1).
# Leave empty to call /api/v1 on the same host the portal is served from.
# Dev: leave empty — Vite proxies /api to VITE_PROXY_TARGET (see vite.config.js).
VITE_API_BASE_URL=

# Tenant subdomain — sent as X-Tenant-Subdomain header AND ?tenant= query param.
# Only needed when the API is reached on a bare IP / localhost; on the school's
# own host (school.example.com) the backend reads the tenant from the host.
VITE_TENANT=

# Dev only: where `npm run dev` proxies /api and /storage.
VITE_PROXY_TARGET=https://project_manager.test
