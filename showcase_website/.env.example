# Base URL of the catalog API (Laravel project_manager, /api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Tenant subdomain — sent as X-Tenant-Subdomain header AND ?tenant= query param
# (required: the API 404s when no tenant can be resolved)
VITE_TENANT=demo

# Branding / display (page title, footer line, price formatting)
VITE_STORE_NAME=SIZE RUN
VITE_CURRENCY=QAR

# Dialling code pre-filled in the checkout mobile field (digits, no "+")
VITE_COUNTRY_CODE=974

# Payments: Tap keys are NOT set here. The storefront is a public bundle — a
# secret key in it is a leaked key. Enter them in the admin under
# Settings → Online Payments; the API talks to Tap on the storefront's behalf.
